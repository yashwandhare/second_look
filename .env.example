# Copy to .env and fill in values. Never commit the real .env file.

# Server
PORT=8000
HOST=0.0.0.0

# Optional. The frontend is served from the same origin, so CORS is off by
# default. Set a comma-separated list only when the frontend is hosted
# separately, for example: https://app.example.com,https://admin.example.com
# CORS_ORIGINS=

# Database. Antideploy supplies DATABASE_URL automatically for projects that
# need Postgres. SQLite is the local default.
# DATABASE_URL=sqlite:///./hackathon.db

# Firestore (Google Services)
# Project ID is not a secret. The API key is a public client identifier; it is
# still read from the environment so it stays out of the repository.
FIREBASE_PROJECT_ID=promptwars-78704
FIREBASE_API_KEY=your_api_key_here
